<section class="hero" style="background-image: url('{{image}}');">
  <div class="container">
    <h1 class="hero__title section-title">{{name}}</h1>
    <h2 class="hero__subtitle section-description">{{shortDescription}}</h2>
    <div class="hero__wrapper">
      <p class="hero__desc">{{description}}</p>
      <div class="hero__features">
        <h3 class="hero__features-title">Переваги цього місця:</h3>
        <ul class="hero__features-list">
          {{#each features}}
            <li class="hero__features-list__item">{{this}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</section>
<section class="map">
  <div class="container">
    <iframe
      src="https://maps.google.com/maps?q={{coordinates.lat}},{{coordinates.lng}}&z=14&output=embed"
      frameborder="0"
    ></iframe>
  </div>
</section>
<section class="gallery">
  <div class="container">
    <ul class="gallery__list">
      {{#each gallery}}
        <li class="gallery__list-item"><img
            src="{{this}}"
            alt="{{this}}"
            class="gallery__list-img"
          /></li>
      {{/each}}
    </ul>
  </div>
</section>
<section class="calendar">
  <div class="container">
    <ul class="calendar__list">
      <li class="calendar__item" data-month-num="1"></li>
      <li class="calendar__item" data-month-num="2"></li>
      <li class="calendar__item" data-month-num="3"></li>
      <li class="calendar__item" data-month-num="4"></li>
      <li class="calendar__item" data-month-num="5"></li>
      <li class="calendar__item" data-month-num="6"></li>
      <li class="calendar__item" data-month-num="7"></li>
      <li class="calendar__item" data-month-num="8"></li>
      <li class="calendar__item" data-month-num="9"></li>
      <li class="calendar__item" data-month-num="10"></li>
      <li class="calendar__item" data-month-num="11"></li>
      <li class="calendar__item" data-month-num="12"></li>
    </ul>
  </div>
</section>