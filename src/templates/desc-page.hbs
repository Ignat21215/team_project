<section class="hero" style="background-image: url('{{image}}');">
  <div class="container">
    <h1 class="hero__title section-title">{{name}}</h1>
    <h2 class="hero__subtitle section-description">{{shortDescription}}</h2>
    <div class="hero__wrapper">
      <p class="hero__desc">{{description}}</p>
      <div class="hero__features">
        <h3 class="hero__features-title">Переваги цього місця:</h3>
        <ul class="hero__features-list">
          {{#each features}}
            <li class="hero__features-list__item">{{this}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</section>
<section class="map">
  <div class="container">
    <h2 class="map__titkle section-title">{{name}} на карті</h2>
    <iframe
      src="https://maps.google.com/maps?q={{coordinates.lat}},{{coordinates.lng}}&z=14&output=embed"
      frameborder="0"
      class="map__frame"
    ></iframe>
  </div>
</section>
<section class="calendar">
  <div class="container">
    <h2 class="calendar__title section-title">Найкращі місяці для подорожі у
      {{name}}</h2>
    <ul class="calendar__list">
      <li class="calendar__item" data-monthNum="1">Січень</li>
      <li class="calendar__item" data-monthNum="2">Лютий</li>
      <li class="calendar__item" data-monthNum="3">Березень</li>
      <li class="calendar__item" data-monthNum="4">Квітень</li>
      <li class="calendar__item" data-monthNum="5">Травень</li>
      <li class="calendar__item" data-monthNum="6">Червень</li>
      <li class="calendar__item" data-monthNum="7">Липень</li>
      <li class="calendar__item" data-monthNum="8">Серпень</li>
      <li class="calendar__item" data-monthNum="9">Вересень</li>
      <li class="calendar__item" data-monthNum="10">Жовтень</li>
      <li class="calendar__item" data-monthNum="11">Листопад</li>
      <li class="calendar__item" data-monthNum="12">Грудень</li>
    </ul>
  </div>
</section>
<section class="gallery">
  <div class="container">
    <ul class="gallery__list">
      {{#each gallery}}
        <li class="gallery__item"><img
            src="{{this}}"
            alt="{{this}}"
            class="gallery__img"
          /></li>
      {{/each}}
    </ul>
    <button type="button" class="gallery__swipe gallery__swipe--left">L</button>
    <button type="button" class="gallery__swipe gallery__swipe--right">R</button>
  </div>
</section>